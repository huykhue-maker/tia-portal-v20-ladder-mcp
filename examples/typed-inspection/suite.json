{
  "blockDir": "blocks",
  "entry": "FB_Check",
  "strictSymbols": true,
  "cases": [
    {
      "name": "Use DB and UDT start values",
      "init": {
        "\"PartPresent\"": 1
      },
      "steps": [
        {
          "run": 1,
          "expect": {
            "#Ready": 1,
            "\"DB_Settings\".Recipe": 4,
            "\"DB_Settings\".Inspection.Threshold": 12
          }
        }
      ]
    },
    {
      "name": "Override the threshold",
      "init": {
        "\"PartPresent\"": 1,
        "\"db_settings\".inspection.threshold": 5
      },
      "steps": [
        {
          "run": 1,
          "expect": {
            "#Ready": 0,
            "\"DB_Settings\".Inspection.Threshold": 5
          }
        }
      ]
    },
    {
      "name": "Start fresh in the next case",
      "init": {
        "\"PartPresent\"": 1
      },
      "steps": [
        {
          "run": 1,
          "expect": {
            "#Ready": 1,
            "\"DB_Settings\".Inspection.Threshold": 12
          }
        }
      ]
    }
  ]
}
